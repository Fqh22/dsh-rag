{
  "name": "dsh-rag-panel",
  "version": "0.7.0",
  "description": "DSH panel for dsh-rag: browse, search and edit per-project memory, plus a session-start pointer to the handoff pack.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rag",
    "memory",
    "mcp",
    "sqlite"
  ],
  "homepage": "https://github.com/Fqh22/dsh-rag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fqh22/dsh-rag.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/Fqh22/dsh-rag/issues"
  },
  "author": "Fqh22",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
