{
  "name": "dsh-rag-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 项目记忆库面板：浏览各项目的交接卡与记忆条目，支持检索与写入",
  "keywords": ["dsh", "dsh-plugin", "rag", "memory"],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "license": "MIT"
}
